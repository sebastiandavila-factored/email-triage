GROQ_API_KEY=secretKeyExample123
API_KEY=dev-local-key
LOGFIRE_TOKEN=
LOGFIRE_SAMPLE_RATE=1.0
LOGFIRE_ENVIRONMENT=dev
# Trace-debug chat (Plan 31): read token with scope `project:read`. Backend-only —
# never expose to the client. Leave empty to disable the feature (endpoint → 503).
# The read API region (US/EU) is derived from the token, so no URL is needed.
LOGFIRE_READ_TOKEN=
# LOGFIRE_READ_BASE_URL=   # optional override; default derives from the token's region
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/email_triage

# Google OAuth2 SSO — leave empty to disable
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback
SESSION_SECRET=replace-with-32-random-bytes-hex
ACCESS_TOKEN_EXPIRE_MINUTES=30
FRONTEND_URL=http://localhost:5173

# Gmail ingestion (Plan 36) — connect a mailbox to pull the day's emails. Reuses the
# GOOGLE_CLIENT_ID/SECRET above with a separate redirect URI (register it in Google
# Cloud Console). GMAIL_TOKEN_ENC_KEY is a Fernet key that encrypts the stored refresh
# token; generate one with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave GMAIL_TOKEN_ENC_KEY empty to disable the feature (endpoints → 503).
GMAIL_REDIRECT_URI=http://localhost:8000/gmail/callback
GMAIL_TOKEN_ENC_KEY=
GMAIL_SYNC_MAX_RESULTS=25

# CORS — leave empty in dev (Vite proxy = same-origin). In prod set to the
# deployed frontend origin(s), comma-separated (no brackets, no quotes):
# CORS_ORIGINS=https://email-triage.vercel.app
CORS_ORIGINS=
ONLINE_EVAL_ENABLED=true